{
  "name": "dsh-web-search-button",
  "description": "Direct web search button and /search slash command plugin for DeepSeek Harness.",
  "version": "0.1.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "search",
    "ui"
  ],
  "license": "MIT",
  "author": "swenbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swenbo1-web/dsh-web-search-button.git"
  },
  "homepage": "https://github.com/swenbo1-web/dsh-web-search-button#readme",
  "bugs": {
    "url": "https://github.com/swenbo1-web/dsh-web-search-button/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^18.3.1",
    "react-dom": "^18.2.0 || ^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
